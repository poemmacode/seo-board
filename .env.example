# ==========================================
# SEOBOARD - CONFIGURACIÓN DE ENTORNO
# ==========================================

# Backend
ENVIRONMENT=production
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/seoboard.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Capa de Inteligencia Artificial (Agnóstica)
# Valores soportados para AI_PROVIDER: 'openai' | 'anthropic' | 'ollama' | 'openai_compatible'
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Claves y URLs según proveedor
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=sk-ant-...

# Si usas Ollama local o en red Docker (e.g. http://host.docker.internal:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
