# ==========================================
# SEOBOARD (Next.js + Supabase) — VARIABLES
# En Vercel: pégalas en Project Settings → Environment Variables.
# En local: copia este archivo a .env.local
# ==========================================

# Supabase (dashboard → Project Settings → API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# IA agnóstica: 'openai' | 'anthropic' | 'ollama' | 'openai_compatible'
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_BASE_URL=http://localhost:11434/v1

# Core Web Vitals (PageSpeed Insights, gratis con cuota).
# Sin esta key la auditoría sigue funcionando pero sin LCP/CLS/INP.
GOOGLE_PAGESPEED_API_KEY=AIza...

# CTA comercial del PDF (opcional)
# NEXT_PUBLIC_CTA_SERVICE=Servicio de Optimización SEO
# NEXT_PUBLIC_CTA_CONTACT=contacto@tudominio.com
# NEXT_PUBLIC_CTA_WEB=www.tudominio.com

# Opcional: si el frontend debe llamar a un backend externo en vez
# del same-origin /api (por defecto se deja vacío).
# NEXT_PUBLIC_API_URL=https://tu-backend.example.com
